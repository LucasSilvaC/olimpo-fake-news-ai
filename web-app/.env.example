NODE_ENV=development
DATABASE_URL=postgresql://postgres:root@127.0.0.1:5432/olimpo
NEXT_PUBLIC_APP_URL=http://localhost:3000
POSTGRES_USER=postgres
POSTGRES_PASSWORD=root
POSTGRES_DB=olimpo
POSTGRES_PORT=5432

# Optional; leave empty to try the public Jina Reader.
JINA_API_KEY=

# Internal Python FP-Growth service. Never expose this as NEXT_PUBLIC_*.
NEWS_INSIGHTS_SERVICE_URL=http://127.0.0.1:8010

# Redis configuration
REDIS_URL=redis://localhost:6379

# Auth configuration
AUTH_SECRET=development-auth-secret-change-in-production-min-32-chars
